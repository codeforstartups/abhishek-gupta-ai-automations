    {
      "parameters": {
        "jsCode": "const inputItems = $input.all();\n\n// Helper: clean text\nfunction cleanText(text) {\n  return text\n    .replace(/\\n+/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nlet chunks = [];\n\nfor (const item of inputItems) {\n  const rawText = item.json.text;\n\n  if (!rawText) continue;\n\n  // Split by numbered list pattern: \"1. \", \"2. \", etc.\n  const entries = rawText.split(/\\n?\\s*(\\d{1,3})\\.\\s+/).filter(Boolean);\n\n  for (let i = 0; i < entries.length; i += 2) {\n    const index = entries[i];\n    const content = entries[i + 1];\n\n    if (!content) continue;\n\n    // Split title and description using dash variations\n    const parts = content.split(/–|-|—/);\n\n    const title = cleanText(parts[0] || \"\");\n    const description = cleanText(parts.slice(1).join(\" \") || \"\");\n\n    if (!title || !description) continue;\n\n    chunks.push({\n      json: {\n        chunk_id: `google_product_${index}`,\n        product_name: title,\n        content: `${title}: ${description}`,\n        metadata: {\n          source: \"google_products_pdf\",\n          product_index: Number(index),\n          type: \"product\",\n        },\n      },\n    });\n  }\n}\n\nreturn chunks;\n"
      },
      "type": "n8n-nodes-base.code",
